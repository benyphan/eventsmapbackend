[Unit]
Description=EventsMap API (FastAPI + Uvicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/eventsmap/backend
EnvironmentFile=/opt/eventsmap/backend/.env
ExecStart=/opt/eventsmap/backend/venv/bin/gunicorn app.main:app \
  -k uvicorn.workers.UvicornWorker \
  --workers 2 \
  --threads 4 \
  --bind 127.0.0.1:8020 \
  --timeout 120
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
